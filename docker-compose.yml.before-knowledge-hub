name: jdap

services:
  postgres:
    image: pgvector/pgvector:pg16
    environment:
      POSTGRES_DB: jdap
      POSTGRES_USER: jdap
      POSTGRES_PASSWORD: jdap
    ports:
      - "5433:5432"
    volumes:
      - jdap_pgdata:/var/lib/postgresql/data
      - ./database/migrations/001_init.sql:/docker-entrypoint-initdb.d/001_init.sql:ro
      - ./database/seed/001_demo.sql:/docker-entrypoint-initdb.d/002_demo.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U jdap -d jdap"]
      interval: 5s
      timeout: 5s
      retries: 20

  backend:
    build: ./backend
    env_file: .env
    volumes:
      - ./database/migrations:/database/migrations:ro
      - ./database/seed:/database/seed:ro
      - ./certs:/run/certs:ro
    environment:
      DATABASE_URL: postgresql://jdap:jdap@postgres:5432/jdap
      PORT: 4001
      NODE_EXTRA_CA_CERTS: ${NODE_EXTRA_CA_CERTS:-}
    ports:
      - "4001:4001"
    depends_on:
      postgres:
        condition: service_healthy

  frontend:
    build: ./frontend
    ports:
      - "4000:80"
    depends_on:
      - backend

volumes:
  jdap_pgdata:
